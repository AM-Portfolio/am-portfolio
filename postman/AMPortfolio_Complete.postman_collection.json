{
  "info": {
    "_postman_id": "am-portfolio-dev-overview-collection",
    "name": "AM Portfolio - Dev Overview Page & 4 Metric Cards",
    "description": "Comprehensive Postman collection for Dev environment testing of all Overview Page endpoints, 4 metric cards, holdings, and timeframes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://am-dev.asrax.in/portfolio",
      "type": "string"
    },
    {
      "key": "portfolioId",
      "value": "7b43596e-12ef-4ddf-bff6-01c17c2f059a",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "167Iff2jQ59CNshqWdscumBrzo_G4oYcpRv4b1t5nstTGp-SZT-tRTzaY24nmbCBqLdK7mflavUgVG-YzaLVQY0Riql2C22rydqIz9JE-EXsfjGbeXs1poB5yiM1QrO24YuODegMUaPvxoY9gxaze6jnno1-Ro9dlT2BkrOj0YdREgULeFJP34E46S8pz3bGVvWsdr6ZxtgBksWXbVqXn9-GzLQfeu4WV77h5TRH3bh-xIUQ4Scsz4NHSDTJMJ8GwVgItFZfq_Dun157BxhYFz7MFE8zMeFYzT_BUwvsBr8X8VAmmSKcl-aPiqjyiNbcgO-uGiwfZWxlwKA",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Overview Page & 4 Metric Cards",
      "item": [
        {
          "name": "1. Get Portfolio Details (Card 1: Total Value & Holdings)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/portfolios/{{portfolioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "portfolios", "{{portfolioId}}"]
            },
            "description": "Retrieves complete 111 equity holdings, total investment value (₹854,184.61), and asset count for Card 1."
          }
        },
        {
          "name": "2. Get Portfolio Summary (Card 2: Gain/Loss 4 Metric Cards)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/portfolios/summary?portfolioId={{portfolioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "portfolios", "summary"],
              "query": [
                {
                  "key": "portfolioId",
                  "value": "{{portfolioId}}"
                }
              ]
            },
            "description": "Retrieves totalGainLoss, totalGainLossPercentage, todayGainLoss, todayGainLossPercentage, and asset counts."
          }
        },
        {
          "name": "3. Get Portfolio History (Card 3: 1D Chart Timeframe)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/portfolios/{{portfolioId}}/history?interval=1D",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "portfolios", "{{portfolioId}}", "history"],
              "query": [
                {
                  "key": "interval",
                  "value": "1D"
                }
              ]
            },
            "description": "Retrieves 1-Day timeframe points for the chart card."
          }
        },
        {
          "name": "4. Get Portfolio History (Card 3: ALL-Timeframe Return Stability)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/portfolios/{{portfolioId}}/history?interval=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "portfolios", "{{portfolioId}}", "history"],
              "query": [
                {
                  "key": "interval",
                  "value": "ALL"
                }
              ]
            },
            "description": "Retrieves All-Time history points ensuring Card 1 total return stays fixed without jumping to 0."
          }
        },
        {
          "name": "5. Get Portfolio Intraday (Card 4: Live Realtime Tracker)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/portfolios/{{portfolioId}}/intraday",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "portfolios", "{{portfolioId}}", "intraday"]
            },
            "description": "Retrieves live intraday ticks for real-time portfolio updates on the Overview Page."
          }
        },
        {
          "name": "6. Get Advanced Overview Analytics (Sector & MarketCap Allocation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeFrame\": \"1D\",\n  \"requestedComponents\": [\"SUMMARY\", \"BENCHMARK_COMPARISON\", \"ASSET_ALLOCATION\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/analytics/portfolio/{{portfolioId}}/advanced",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "analytics", "portfolio", "{{portfolioId}}", "advanced"]
            },
            "description": "Retrieves advanced sectorial and market-cap breakdown for Overview analytics."
          }
        }
      ]
    }
  ]
}