FROM eclipse-temurin:21-jdk-jammy
WORKDIR /app
RUN groupadd -g 1000 spring && useradd -u 1000 -g spring -s /bin/sh -m spring && mkdir -p /var/log/am-portfolio && chown -R spring:spring /app /var/log/am-portfolio
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/* && ln -sf /usr/share/zoneinfo/Asia/Kolkata /etc/localtime
COPY --chown=spring:spring deploy-staging/app.jar app.jar
USER 1000:1000
ENV SPRING_PROFILES_ACTIVE=docker
ENV TZ=Asia/Kolkata
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 CMD curl -f http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
