                <mxCell id="c4t" value="4. VOLATILITY — weight in Health: 15%  ★ (history required)" style="text;html=1;fontStyle=1;fontSize=12;fontColor=#006064;" parent="1" vertex="1">
                    <mxGeometry x="910" y="495" width="500" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c4m" value="Modules&#10;• portfolio history / value series&#10;  (existing snapshot history path)&#10;• portfolio-market-data client&#10;• am-market-data HTTP — NO CODE CHANGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838f;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
