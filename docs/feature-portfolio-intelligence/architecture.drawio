                <mxCell id="c1m" value="Modules&#10;• Snapshot holdings + sector tags&#10;• Security metadata (sector)&#10;• No market history required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="55" y="345" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c1d" value="Data / % basis&#10;• N = count of holdings with weight&#10;• S = count of distinct sectors&#10;• Optional evenness of weight%&#10;• NOT “N% = N stocks”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="270" y="345" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c1l" value="Backend logic → Score 0–100&#10;More names + more sectors + less&#10;skew → HIGHER score.&#10;15 stocks / 6 sectors ≈ medium.&#10;150 stocks / 12 sectors ≈ higher&#10;UNLESS one sector still owns most ₹." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
