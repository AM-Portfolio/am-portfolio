                <mxCell id="c4d" value="Data / % basis&#10;• dailyReturn_t = (V_t−V_{t-1})/V_{t-1}&#10;• rawVol = stddev(dailyReturn[])&#10;• Portfolio-level, not per-stock count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838f;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
