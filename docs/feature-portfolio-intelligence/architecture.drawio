                </mxCell>
                <mxCell id="c2m" value="Modules&#10;• Snapshot weight%&#10;• Sector groups (same as X-Ray)&#10;• Allocation providers reuse OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="915" y="345" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c2d" value="Data / % basis&#10;• top1Weight% = max stock value÷total×100&#10;• topSectorWeight% = max sector÷total×100&#10;• Optional HHI = Σ(weight/100)²" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="345" width="260" height="110" as="geometry"/>
