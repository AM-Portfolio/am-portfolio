                <mxCell id="c3m" value="Modules&#10;• portfolio-service summary&#10;  (gain/return REUSE)&#10;• Optional NIFTY via market-data&#10;• Snapshot totalValue / investment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
