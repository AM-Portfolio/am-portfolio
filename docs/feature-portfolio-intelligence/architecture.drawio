                <mxCell id="c4l" value="Backend logic → Score 0–100&#10;Higher rawVol (jumpier) → LOWER score.&#10;Map rawVol → 0–100 via engine constants.&#10;Too few history points → OMIT component&#10;+ renormalize Health weights (no fake vol)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2ebf2;strokeColor=#00838f;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
